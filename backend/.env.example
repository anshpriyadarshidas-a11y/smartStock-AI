PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES=8h

# CORS: comma-separated list of allowed frontend origins ('*' to allow all).
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Data persistence. db.json is a local file store that requires no MongoDB.
# Point MONGO_URI at a MongoDB instance to switch the data layer (see docs/DEPLOYMENT.md).
MONGO_URI=mongodb://localhost:27017/smartstock
MONGO_DB_NAME=smartstock

# Python ML service (Flask). If unset, the built-in forecast engine is used.
AI_SERVICE_URL=http://localhost:5000

# Market intelligence (optional). Leave empty to use the simulated category
# baseline. TREND_API_URL / GOOGLE_TRENDS_URL should return { score: 0..100 }.
TREND_API_URL=
GOOGLE_TRENDS_URL=
NEWS_API_KEY=

# Optional notifications. Without credentials, notifications are logged only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
