PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES=8h

# Data persistence. db.json is a local file store that requires no MongoDB.
# Point MONGO_URI at a MongoDB instance to switch the data layer (see docs/DEPLOYMENT.md).
MONGO_URI=

# Optional Python ML service (FastAPI). If unset, the built-in forecast engine is used.
AI_SERVICE_URL=

# Optional notifications. Without credentials, notifications are logged only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
