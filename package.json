{
  "name": "smartstock-ai",
  "version": "1.0.0",
  "private": true,
  "description": "SmartStock AI - Agent-Driven Inventory Operations Platform with Human Approval",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "install:all": "npm install --workspaces && pip install -r ai-service/requirements.txt",
    "dev": "npm run dev --workspace backend",
    "start": "npm run start --workspace backend",
    "test": "npm run test --workspace backend",
    "test:e2e": "playwright test",
    "lint": "npm run lint --workspace backend",
    "seed": "npm run seed --workspace backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1"
  },
  "engines": {
    "node": ">=20"
  }
}
